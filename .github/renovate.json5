{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "docker:enableMajor",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":automergeDisabled",
    "github>jlejeune/jlejeune.home-ansible//.github/renovate/commitMessage.json5",
    "github>jlejeune/jlejeune.home-ansible//.github/renovate/labels.json5",
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "suppressNotifications": ["prIgnoreNotification"],
  "rebaseWhen": "conflicted",
  "schedule": ["every saturday"],
  "flux": {
    "fileMatch": ["cluster/.+\\.ya?ml$"]
  },
  "helm-values": {
    "fileMatch": ["cluster/.+\\.ya?ml$"]
  },
  "kubernetes": {
    "fileMatch": [
      "ansible/.+\\.(ya?ml(\\.j2)?|j2)$",
      "cluster/.+\\.ya?ml$"
    ]
  },
  "customManagers": [
    {
      // Kluctl helmChart with Helm repo (repo: + chartName: + chartVersion:)
      "customType": "regex",
      "fileMatch": ["cluster/.+/helm-chart\\.ya?ml$"],
      "matchStrings": [
        "repo:\\s*(?<registryUrl>[^\\n]+)\\n\\s+chartName:\\s*(?<depName>[^\\n]+)\\n\\s+chartVersion:\\s*[\"']?(?<currentValue>[^\\n\"']+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      // Kluctl helmChart with Git tag (git.ref.tag:)
      "customType": "regex",
      "fileMatch": ["cluster/.+/helm-chart\\.ya?ml$"],
      "matchStrings": [
        "url:\\s*https://github\\.com/(?<depName>[^\\n]+)\\n[\\s\\S]+?tag:\\s*(?<currentValue>[^\\n]+)"
      ],
      "datasourceTemplate": "github-releases"
    }
  ]
}
