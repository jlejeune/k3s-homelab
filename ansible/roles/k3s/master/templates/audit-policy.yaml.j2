apiVersion: audit.k8s.io/v1
kind: Policy
rules:
  # Ignore read-only and noisy system resources
  - level: None
    resources:
      - group: ""
        resources: ["events"]
  - level: None
    resources:
      - group: "coordination.k8s.io"
        resources: ["leases"]
  - level: None
    users: ["system:kube-proxy"]
    verbs: ["watch"]
  - level: None
    users: ["system:node"]
    verbs: ["get"]
    resources:
      - group: ""
        resources: ["nodes", "pods"]
  # Log everything else at Metadata level
  - level: Metadata
